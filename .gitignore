# secrets
.env
.env.*
!.env.example

# python build / cache artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# host-only python pinning (we're Docker-only; see TODO.md working agreement)
.venv/
.python-version

# OS / editor
.DS_Store
*.swp

# build artifacts (Chrome Web Store variant — produced by scripts/build-store.sh)
dist/

# Playwright が作るブラウザプロファイル。キャッシュに 100MB 超の blob が
# 入るため、git add -A で巻き込むと GitHub の push が pre-receive で落ちる。
tests/integration/.tmp-profile-*/
.playwright-mcp/

# Chrome に unpacked で読み込ませる作業用コピー。
# browser-extension/scripts/sync-dev.sh が生成するので追跡しない。
/dev/

# 配布用の zip。browser-extension/scripts/build-store-zip.sh がリポジトリ直下に作る。
/pii-guard-v*.zip

# 別リポジトリへ移した実験。モデルとデータで数 GB あるので、git add -A で巻き込まない。
/experiments/privacy-filter-ja/

# ML 判定層のモデル本体。onnx_data は 1.0 GB で GitHub の 1 ファイル 100 MB 制限を超え、
# model.onnx (8.4 MB) と tokenizer.json (20 MB) も fetch-model.sh の生成物なので git に置かない。
# 追跡するのは config.json と tokenizer_config.json だけ (model_type の書き換えなど、
# 読み取りの前提が読めるようにするため)。
/browser-extension/model/jev-0.8b/model.onnx
/browser-extension/model/jev-0.8b/model.onnx_data
/browser-extension/model/jev-0.8b/tokenizer.json

# Claude Code が作る端末ローカルのファイル (worktree・会話の記録・個人設定)。
/.claude/worktrees/
/.claude/projects/
.claude/settings.local.json

# ゲートウェイが実行時に作るファイル。管理トークンは初回起動時に乱数で生成される。
# (2026-09-28 まで data/admin_token が追跡されていて、トークンが公開されていた)
/data/
