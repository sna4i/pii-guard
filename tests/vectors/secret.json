    {
      "name": "negative — 変更の依頼は値ではない (1.5.1)",
      "input": "パスワードを変更してください",
      "expected_absent": [{ "label": "SECRET" }]
    },
    {
      "name": "negative — 短すぎる語 (1.5.1)",
