{
  "label_groups": ["SECURITY_CODE", "CARD_EXPIRY", "PURCHASE_ORDER", "CUSTOMER_ID", "KATAKANA_NAME", "PERSON", "JP_SURNAME", "PHONE_NUMBER"],
  "cases": [
    {
      "name": "CVV — セキュリティコードの数字だけ隠す (手がかり語と離れていても)",
      "input": "セキュリティコードについてはテスト環境上のみ「123」と設定されています。",
      "expected": [{ "label": "SECURITY_CODE", "text": "123" }]
    },
    {
      "name": "CVV — CVV ラベル",
      "input": "CVV: 456 を入力",
      "expected": [{ "label": "SECURITY_CODE", "text": "456" }]
    },
    {
      "name": "CVV 文脈が無い裸の 3 桁は拾わない",
      "input": "身長は123cmです",
      "expected_absent": [{ "label": "SECURITY_CODE" }]
    },
    {
      "name": "カード有効期限 MM/YY",
      "input": "有効期限12/30、名義TARO YAMADA",
      "expected": [{ "label": "CARD_EXPIRY", "text": "12/30" }]
    },
    {
      "name": "名義のローマ字は PERSON で拾う",
      "input": "カード名義TARO YAMADA が保存されています",
      "expected": [{ "label": "PERSON", "text": "TARO YAMADA" }]
    },
    {
      "name": "名義のカタカナ (連結語なし) は KATAKANA_NAME",
      "input": "口座名義ヤマダ タロウ として登録",
      "expected": [{ "label": "KATAKANA_NAME", "text": "ヤマダ タロウ" }]
    },
    {
      "name": "注文番号 ORD- (ラベルごと 1 span で隠す、発注番号と同じ流儀)",
      "input": "注文番号ORD-20260920-785412の商品について",
      "expected": [{ "label": "PURCHASE_ORDER", "text": "注文番号ORD-20260920-785412" }]
    },
    {
      "name": "ログ中の顧客ID (Customer が近くにある)",
      "input": "INFO Customer profile accessed: C-00045872",
      "expected": [{ "label": "CUSTOMER_ID", "text": "C-00045872" }]
    },
    {
      "name": "下4桁で示される番号",
      "input": "登録電話番号の下4桁「5678」を確認",
      "expected": [{ "label": "PHONE_NUMBER", "text": "5678" }]
    }
  ]
}
